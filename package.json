{
	"name": "n8n-nodes-getyoutubetranscript",
	"version": "0.1.2",
	"description": "n8n community node for the GetYouTubeTranscript API - YouTube transcripts, search, channel, and playlist data",
	"license": "MIT",
	"homepage": "https://getyoutubetranscript.com",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"n8n-community-node-package",
		"youtube",
		"transcript",
		"youtube-transcript",
		"youtube-search",
		"youtube-api"
	],
	"author": {
		"name": "tubeagentkit",
		"email": "hello@tubeagentkit.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tubeagentkit/n8n-nodes-getyoutubetranscript.git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test:live": "tsx test/live-test.ts"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GetYouTubeTranscriptApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/GetYouTubeTranscript/GetYouTubeTranscript.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "^9.39.4",
		"prettier": "3.9.9",
		"release-it": "20.2.0",
		"tsx": "4.23.15",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
